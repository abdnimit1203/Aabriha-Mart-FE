NEXT_PUBLIC_API_URL=http://localhost:5000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe (test mode publishable key — safe to expose client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# bKash/Nagad merchant "Send Money" number — shown as static checkout instructions
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=

# Sitewide announcement bar — bar is hidden entirely when text is empty.
# No admin UI yet; edit this and redeploy to change/toggle it.
NEXT_PUBLIC_ANNOUNCEMENT_TEXT=

# WhatsApp click-to-chat number, e.g. 8801XXXXXXXXX (country code, no +/spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Footer contact info — each is hidden individually when unset
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
